# svanDoc staging profile (managed services)
# Copy to `.env.staging` and set real secrets/hosts.

APP_ENV=staging
JWT_SECRET=replace-with-staging-secret
MAX_UPLOAD_MB=25
MAX_UPLOAD_PAGES=20

FRONTEND_PORT=3000
API_PORT=8000
WORKER_HEARTBEAT_SECONDS=2

# Managed Supabase Postgres pooler URL (IPv4-compatible)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Managed Redis URL
REDIS_URL=redis://default:<redis-password>@<redis-host>:6379/0

QUEUE_BACKEND=celery
CELERY_TASK_ALWAYS_EAGER=0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage-staging

S3_BUCKET=svandoc-staging
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_STUB_STORAGE_PATH=./data/s3-stub-staging

VLLM_BASE_URL=http://localhost:11434/v1
VLLM_FALLBACK_BASE_URL=http://localhost:11435/v1
VLLM_API_KEY=
OCR_DEFAULT_MODEL=rednote-hilab/dots.ocr
OCR_FALLBACK_MODEL=datalab-to/chandra

ALERT_FAILED_RECENT_THRESHOLD=5
ALERT_QUEUE_BACKLOG_DEPTH=25
ALERT_API_ERROR_RATE_THRESHOLD=0.2

RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_UPLOAD_MAX_REQUESTS=30
RATE_LIMIT_BLOCK_SECONDS=300

API_START_MODE=fastapi
FRONTEND_START_MODE=nextjs
WORKER_START_MODE=celery
