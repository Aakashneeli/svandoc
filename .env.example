# svanDoc local development environment template
# Copy to `.env` and adjust values as needed.

# ------------------------------------------------------------
# Core app environment
# ------------------------------------------------------------
APP_ENV=local
JWT_SECRET=change-me-local-secret
MAX_UPLOAD_MB=25
MAX_UPLOAD_PAGES=20

# ------------------------------------------------------------
# Network ports
# ------------------------------------------------------------
FRONTEND_PORT=3000
API_PORT=8000
WORKER_HEARTBEAT_SECONDS=2

# ------------------------------------------------------------
# Data services
# ------------------------------------------------------------
# Supabase Postgres (recommended):
# 1) In Supabase dashboard: Project Settings -> Database -> Connection string.
# 2) Use URI format and URL-encode password if it has special characters.
# 3) Keep sslmode=require for hosted Supabase.
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=celery
CELERY_TASK_ALWAYS_EAGER=0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# ------------------------------------------------------------
# Storage configuration
# ------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage

# Used when STORAGE_BACKEND=s3
S3_BUCKET=svandoc-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_STUB_STORAGE_PATH=./data/s3-stub

# ------------------------------------------------------------
# OCR / inference
# ------------------------------------------------------------
# Primary vLLM endpoint for OCR default model (`OCR_DEFAULT_MODEL`)
VLLM_BASE_URL=http://localhost:11434/v1
# Fallback vLLM endpoint for fallback model (`OCR_FALLBACK_MODEL`)
VLLM_FALLBACK_BASE_URL=http://localhost:11435/v1
VLLM_API_KEY=
# Canonical upstream model IDs (Hugging Face)
OCR_DEFAULT_MODEL=rednote-hilab/dots.ocr
OCR_FALLBACK_MODEL=datalab-to/chandra

# ------------------------------------------------------------
# Startup command hints
# (Used by local startup scripts in placeholder mode until app bootstraps)
# ------------------------------------------------------------
API_START_MODE=fastapi
FRONTEND_START_MODE=placeholder
WORKER_START_MODE=celery

# ------------------------------------------------------------
# Alert thresholds (T-054)
# ------------------------------------------------------------
# Alert when recent failed jobs count (rolling in-process window) crosses threshold.
ALERT_FAILED_RECENT_THRESHOLD=5
# Alert when queue depth crosses threshold.
ALERT_QUEUE_BACKLOG_DEPTH=25
# Alert when API error rate crosses threshold.
ALERT_API_ERROR_RATE_THRESHOLD=0.2

# ------------------------------------------------------------
# API rate limiting / abuse guardrails (T-055)
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_UPLOAD_MAX_REQUESTS=30
RATE_LIMIT_BLOCK_SECONDS=300

# ------------------------------------------------------------
# Outbound webhooks (T-064)
# ------------------------------------------------------------
# Comma-separated HTTPS endpoints that receive signed webhook events.
WEBHOOK_ENDPOINTS=
# Required to sign payloads with HMAC-SHA256.
WEBHOOK_SIGNING_SECRET=
# Delivery retry policy.
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_RETRY_BACKOFF_SECONDS=2

# ------------------------------------------------------------
# Zapier integration (T-065)
# ------------------------------------------------------------
# Shared key required by Zapier trigger/action endpoints.
ZAPIER_API_KEY=

# ------------------------------------------------------------
# Make.com integration (T-066)
# ------------------------------------------------------------
# Shared key required by Make template endpoint.
MAKE_API_KEY=
# Optional explicit API base URL used in generated Make templates.
MAKE_API_BASE_URL=

# ------------------------------------------------------------
# QuickBooks connector (T-067)
# ------------------------------------------------------------
# QuickBooks Online API base (override only for testing/mocking).
QUICKBOOKS_API_BASE_URL=https://quickbooks.api.intuit.com

# ------------------------------------------------------------
# Xero connector (T-068)
# ------------------------------------------------------------
# Xero API base (override only for testing/mocking).
XERO_API_BASE_URL=https://api.xero.com/api.xro/2.0

