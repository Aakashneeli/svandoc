{
  "name": "svandoc-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js frontend for svanDoc.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint app components --max-warnings=0",
    "test": "node --test --test-isolation=none tests/smoke.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:routes": "node --test tests/smoke.test.mjs"
  },
  "dependencies": {
    "next": "^14.2.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
