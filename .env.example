# svanDoc local development environment template
# Copy to `.env` and adjust values as needed.

# ------------------------------------------------------------
# Core app environment
# ------------------------------------------------------------
APP_ENV=local
JWT_SECRET=change-me-local-secret
MAX_UPLOAD_MB=25

# ------------------------------------------------------------
# Network ports
# ------------------------------------------------------------
FRONTEND_PORT=3000
API_PORT=8000
WORKER_HEARTBEAT_SECONDS=2

# ------------------------------------------------------------
# Data services
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svandoc
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Storage configuration
# ------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage

# Used when STORAGE_BACKEND=s3
S3_BUCKET=svandoc-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# ------------------------------------------------------------
# OCR / inference
# ------------------------------------------------------------
VLLM_BASE_URL=http://localhost:11434/v1
VLLM_API_KEY=
OCR_DEFAULT_MODEL=dots.ocr
OCR_FALLBACK_MODEL=chandra

# ------------------------------------------------------------
# Startup command hints
# (Used by local startup scripts in placeholder mode until app bootstraps)
# ------------------------------------------------------------
API_START_MODE=fastapi
FRONTEND_START_MODE=placeholder
WORKER_START_MODE=placeholder
